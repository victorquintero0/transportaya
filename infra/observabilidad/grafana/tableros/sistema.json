{
  "uid": "transportaya-sistema",
  "title": "TransporteYa · Sistema",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": ["transportaya"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Solicitudes por segundo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ty_http_solicitudes_total[1m]))",
          "legendFormat": "total"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ty_http_solicitudes_total{estado=~\"5..\"}[1m]))",
          "legendFormat": "con error del servidor"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tiempo de respuesta (p50 y p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ty_http_duracion_segundos_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ty_http_duracion_segundos_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rutas con más errores",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, sum by (ruta) (rate(ty_http_solicitudes_total{estado=~\"5..\"}[5m])))",
          "legendFormat": "{{ruta}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Conexiones en tiempo real",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rol) (ty_ws_conexiones)",
          "legendFormat": "{{rol}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Viajes activos por estado",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ty_viajes_activos",
          "legendFormat": "{{estado}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Conductores por estado",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ty_conductores",
          "legendFormat": "{{estado}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Conexiones a la base de datos",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ty_bd_conexiones",
          "legendFormat": "{{estado}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Segundos desde el último éxito de cada tarea",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - ty_tarea_ultimo_exito_timestamp_segundos",
          "legendFormat": "{{tarea}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Errores reportados por las apps",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (increase(ty_cliente_errores_total[10m]))",
          "legendFormat": "{{app}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  }
}
