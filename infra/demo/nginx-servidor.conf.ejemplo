# Ejemplo para el nginx que YA tienes en el servidor (el que entrega tus otras paginas con HTTPS).
# Guardalo como /etc/nginx/sites-available/transportaya.vitasi.cloud, enlazalo desde sites-enabled y recarga:
#   sudo ln -s /etc/nginx/sites-available/transportaya.vitasi.cloud /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Los tres nombres van al mismo contenedor (127.0.0.1:8085), que decide a que app corresponde cada uno.
# Ajusta las dos rutas del certificado si el tuyo esta en otro lugar.

map $http_upgrade $conexion_transportaya {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name transportaya.vitasi.cloud transportaya-conductor.vitasi.cloud transportaya-operacion.vitasi.cloud;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name transportaya.vitasi.cloud transportaya-conductor.vitasi.cloud transportaya-operacion.vitasi.cloud;

    # El certificado wildcard de *.vitasi.cloud
    ssl_certificate /etc/letsencrypt/live/vitasi-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vitasi-wildcard/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8085;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # El tiempo real (WebSocket)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $conexion_transportaya;
        proxy_read_timeout 1h;
    }
}
