# Ejemplo para el nginx que YA tienes en el servidor (el que entrega tus otras paginas con HTTPS).
# Copialo a /etc/nginx/conf.d/transportaya.conf (o sites-available), ajusta las rutas del certificado y recarga:
#   sudo nginx -t && sudo systemctl reload nginx
# Los tres nombres van al mismo contenedor, que decide a que app corresponde cada uno.

map $http_upgrade $conexion_transportaya {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name transportaya.vitasi.cloud transportaya-conductor.vitasi.cloud transportaya-operacion.vitasi.cloud;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name transportaya.vitasi.cloud transportaya-conductor.vitasi.cloud transportaya-operacion.vitasi.cloud;

    # El certificado wildcard de *.vitasi.cloud
    ssl_certificate     /ruta/a/vitasi.cloud/fullchain.pem;
    ssl_certificate_key /ruta/a/vitasi.cloud/privkey.pem;

    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8085;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # El tiempo real (WebSocket)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $conexion_transportaya;
        proxy_read_timeout 1h;
    }
}
