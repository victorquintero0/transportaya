# Copia este archivo como .env y cambia los valores marcados.
HOST_PASAJERO=transportaya.vitasi.cloud
HOST_CONDUCTOR=transportaya-conductor.vitasi.cloud
HOST_OPERACION=transportaya-operacion.vitasi.cloud
PUERTO_WEB=8085
# Cambialas: openssl rand -hex 16   y   openssl rand -hex 32
DB_CLAVE=cambia-esto
JWT_SECRET=cambia-esto-por-64-caracteres-aleatorios
# Usuario y clave para ver las apps (muy recomendado: la demo trae cuentas de acceso con un clic).
# Si los dejas vacios, cualquiera que conozca la direccion podra entrar.
DEMO_USUARIO=demo
DEMO_CLAVE=cambia-esto
