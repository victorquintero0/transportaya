# Copiar a .env para desarrollo local. Nunca subir secretos reales al repositorio.
NODE_ENV=development
PORT=3000

# Servicios locales (infra/docker/docker-compose.yml)
DATABASE_URL=postgres://transportaya:transportaya@localhost:5432/transportaya
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=transportaya
S3_SECRET_KEY=transportaya-dev
SMTP_HOST=localhost
SMTP_PORT=1025

# App Operación: primera cuenta de administración (se crea al arrancar si no hay ningún empleado).
# Con SIMULADOR=true y sin estas variables se crean cuentas de demostración, una por rol. Nunca en producción.
# ADMIN_INICIAL_EMAIL=admin@transporteya.co
# ADMIN_INICIAL_CONTRASENA=cambia-esta-contrasena-1A
